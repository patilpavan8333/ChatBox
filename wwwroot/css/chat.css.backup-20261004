* {
    box-sizing: border-box;
}

html,
body {
    height: 100%;
    margin: 0;
    overflow: hidden;
}

body {
    font-family: Arial, sans-serif;
    background: #f1f5f9;
}


/* =========================
   LOGIN
   ========================= */

#loginScreen {
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.login-box {
    width: 90%;
    max-width: 380px;
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, .15);
    text-align: center;
}

.login-box h1 {
    margin-bottom: 25px;
}

.login-box input {
    width: 100%;
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
    margin-bottom: 12px;
}

.login-box button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

#loginError {
    color: #dc2626;
    margin-top: 12px;
}


/* =========================
   CHAT
   ========================= */

#chatScreen {
    width: 100%;
    max-width: 900px;
    height: 100vh;
    height: 100dvh;
    margin: auto;
    background: white;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}


/* =========================
   HEADER
   ========================= */

.chat-header {
    flex: 0 0 auto;
    position: relative;
    z-index: 20;

    padding: 12px 18px;
    background: #2563eb;
    color: white;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-header h2 {
    margin: 0;
    font-size: 21px;
}

#otherStatus {
    display: block;
    margin-top: 4px;
    font-size: 13px;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

#connectionStatus {
    font-size: 13px;
}


/* =========================
   CALL BUTTONS
   ========================= */

.call-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
}

.call-button {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: white;
    color: #2563eb;
    font-size: 18px;
    cursor: pointer;
}

.call-button:hover {
    background: #dbeafe;
}

.call-button:disabled {
    opacity: .4;
    cursor: not-allowed;
}


/* =========================
   SELECTION TOOLBAR
   ========================= */

.selection-toolbar {
    flex: 0 0 auto;
    min-height: 54px;

    padding: 8px 12px;

    background: white;
    border-bottom: 1px solid #ddd;

    display: flex;
    align-items: center;
    gap: 12px;

    position: relative;
    z-index: 30;
}

.selection-toolbar > button,
.selection-actions button {
    border: none;
    background: transparent;
    font-size: 21px;
    cursor: pointer;
    padding: 7px;
}

#selectionCount {
    font-weight: bold;
    flex: 1;
}

.selection-actions {
    display: flex;
    gap: 4px;
}


/* =========================
   REACTION BAR
   ========================= */

.reaction-bar {
    position: fixed;

    left: 50%;
    transform: translateX(-50%);

    bottom: 82px;

    background: white;
    border-radius: 30px;

    padding: 7px 10px;

    display: flex;
    gap: 3px;

    box-shadow: 0 5px 25px rgba(0,0,0,.25);

    z-index: 200;
}

.reaction-bar button {
    border: none;
    background: transparent;
    font-size: 25px;
    padding: 5px;
    cursor: pointer;
    border-radius: 50%;
}

.reaction-bar button:hover {
    background: #f1f5f9;
}


/* =========================
   MESSAGES
   ========================= */

#messages {
    flex: 1 1 auto;
    min-height: 0;

    overflow-y: auto;
    overflow-x: hidden;

    padding: 20px;

    background: #f8fafc;

    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
}

.message-row {
    display: flex;
    width: 100%;
    margin-bottom: 5px;
    transition: transform .15s ease;
}

.message-row.me {
    justify-content: flex-end;
}

.message-row.other {
    justify-content: flex-start;
}

.message {
    position: relative;

    max-width: 75%;

    padding: 9px 12px 6px;

    border-radius: 14px;

    word-wrap: break-word;

    user-select: none;

    touch-action: pan-y;

    cursor: pointer;

    transition:
        background .15s ease,
        transform .15s ease;
}

.message.me {
    background: #dbeafe;
    border-bottom-right-radius: 4px;
}

.message.other {
    background: #e2e8f0;
    border-bottom-left-radius: 4px;
}

.message.selected {
    outline: 3px solid rgba(37, 99, 235, .35);
    background: #bfdbfe;
}

.message strong {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
}

.message-text {
    white-space: pre-wrap;
    line-height: 1.4;
    font-size: 15px;
}

.message-meta {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
}

.message-time {
    color: #64748b;
    font-size: 10px;
    white-space: nowrap;
}

.message-status {
    font-size: 13px;
    line-height: 1;
    color: #64748b;
}

.message-status.seen {
    color: #2563eb;
}


/* =========================
   REPLY PREVIEW INSIDE MESSAGE
   ========================= */

.message-reply {
    border-left: 4px solid #2563eb;
    background: rgba(255,255,255,.55);

    padding: 6px 8px;
    margin-bottom: 7px;

    border-radius: 5px;

    overflow: hidden;
}

.message-reply strong {
    color: #2563eb;
    margin: 0 0 2px;
    font-size: 11px;
}

.message-reply span {
    display: block;
    font-size: 12px;
    color: #475569;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* =========================
   REACTIONS ON MESSAGE
   ========================= */

.message-reactions {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;

    margin-top: 4px;
}

.reaction-pill {
    background: white;

    border: 1px solid #cbd5e1;

    border-radius: 12px;

    padding: 2px 6px;

    font-size: 12px;
}


/* =========================
   DELETED MESSAGE
   ========================= */

.deleted-message {
    color: #64748b;
    font-style: italic;
}


/* =========================
   IMAGE
   ========================= */

.chat-image {
    display: block;

    max-width: 280px;
    max-height: 350px;

    width: auto;
    height: auto;

    object-fit: contain;

    margin-top: 5px;

    border-radius: 10px;
}


/* =========================
   REPLY PREVIEW ABOVE INPUT
   ========================= */

.reply-preview {
    flex: 0 0 auto;

    display: flex;
    align-items: center;

    gap: 10px;

    padding: 8px 12px;

    background: white;

    border-top: 1px solid #ddd;

    border-left: 4px solid #2563eb;
}

.reply-preview-content {
    flex: 1;
    min-width: 0;

    display: flex;
    flex-direction: column;
}

#replyPreviewTitle {
    color: #2563eb;
    font-size: 12px;
}

#replyPreviewText {
    color: #475569;
    font-size: 13px;

    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.reply-preview > button {
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
}


/* =========================
   INPUT
   ========================= */

.chat-input-area {
    flex: 0 0 auto;

    display: flex;

    gap: 8px;

    padding: 10px;

    border-top: 1px solid #ddd;

    background: white;

    position: relative;
    z-index: 20;
}

.chat-input-area input[type="text"] {
    flex: 1;

    min-width: 0;

    padding: 12px 16px;

    border: 1px solid #ccc;

    border-radius: 20px;

    outline: none;

    font-size: 15px;
}

.chat-input-area input[type="text"]:focus {
    border-color: #2563eb;
}

.chat-input-area > button {
    flex: 0 0 auto;

    width: 46px;
    height: 46px;

    border: none;

    border-radius: 50%;

    background: #2563eb;

    color: white;

    font-size: 19px;

    cursor: pointer;
}

.chat-input-area .image-button {
    background: #e2e8f0;
    color: #334155;
}


/* =========================
   INCOMING CALL
   ========================= */

.call-popup {
    position: fixed;
    inset: 0;

    background: rgba(0,0,0,.55);

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 1000;
}

.call-popup-box {
    width: 90%;
    max-width: 360px;

    background: white;

    border-radius: 20px;

    padding: 30px;

    text-align: center;

    box-shadow: 0 10px 40px rgba(0,0,0,.3);
}

.call-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.call-popup-box h2 {
    margin: 0 0 8px;
}

.call-popup-box p {
    color: #64748b;
    margin-bottom: 25px;
}

.incoming-call-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.incoming-call-buttons button {
    border: none;

    padding: 12px 18px;

    border-radius: 10px;

    color: white;

    font-size: 15px;

    cursor: pointer;
}

.accept-call {
    background: #16a34a;
}

.reject-call {
    background: #dc2626;
}


/* =========================
   ACTIVE CALL
   ========================= */

.active-call-screen {
    position: fixed;
    inset: 0;

    background: #0f172a;

    z-index: 2000;

    display: flex;
    flex-direction: column;
}

.active-call-header {
    padding: 18px;

    color: white;

    display: flex;
    justify-content: space-between;

    background: #111827;
}

#activeCallUser {
    font-size: 18px;
    font-weight: bold;
}

#activeCallStatus {
    font-size: 14px;
    color: #94a3b8;
}

.video-area {
    flex: 1;

    position: relative;

    display: flex;

    align-items: center;
    justify-content: center;

    overflow: hidden;
}

#remoteVideo {
    width: 100%;
    height: 100%;

    object-fit: contain;

    background: #000;
}

#localVideo {
    position: absolute;

    right: 20px;
    bottom: 20px;

    width: 180px;
    height: 130px;

    object-fit: cover;

    background: #000;

    border-radius: 12px;

    border: 2px solid white;
}

.call-controls {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 12px;

    padding: 20px;

    background: #111827;
}

.call-controls button {
    border: none;

    border-radius: 25px;

    padding: 12px 18px;

    background: white;

    color: #111827;

    font-size: 14px;

    cursor: pointer;
}

.call-controls .end-call {
    background: #dc2626;
    color: white;
}


/* =========================
   STATUS
   ========================= */

.online {
    color: #22c55e;
}

.offline {
    color: #cbd5e1;
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 600px) {

    .chat-header {
        padding: 10px 12px;
    }

    .chat-header h2 {
        font-size: 18px;
    }

    .header-right {
        gap: 6px;
    }

    #connectionStatus {
        display: none;
    }

    .call-button {
        width: 38px;
        height: 38px;
        font-size: 16px;
    }

    #messages {
        padding: 12px 8px;
    }

    .message {
        max-width: 85%;
    }

    .chat-input-area {
        padding:
            8px
            max(8px, env(safe-area-inset-right))
            max(8px, env(safe-area-inset-bottom))
            max(8px, env(safe-area-inset-left));
    }

    .chat-input-area > button {
        width: 44px;
        height: 44px;
    }

    .reaction-bar {
        bottom: 72px;

        max-width: 96%;

        overflow-x: auto;
    }

    .reaction-bar button {
        font-size: 23px;
    }

    .chat-image {
        max-width: 240px;
        max-height: 300px;
    }

    #localVideo {
        width: 120px;
        height: 90px;

        right: 10px;
        bottom: 10px;
    }

    .call-controls {
        padding: 12px 8px;
        gap: 6px;
    }

    .call-controls button {
        padding: 10px 12px;
        font-size: 12px;
    }
}
