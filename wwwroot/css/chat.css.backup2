* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
}


/* =========================
   LOGIN
   ========================= */

#loginScreen {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.login-box {
    width: 90%;
    max-width: 380px;
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
    text-align: center;
}

.login-box h1 {
    margin-bottom: 25px;
}

.login-box input {
    width: 100%;
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
    margin-bottom: 12px;
}

.login-box button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

.login-box button:hover {
    background: #1d4ed8;
}

#loginError {
    color: #dc2626;
    margin-top: 12px;
}


/* =========================
   CHAT
   ========================= */

#chatScreen {
    height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 900px;
    margin: auto;
    background: white;
}


/* =========================
   HEADER
   ========================= */

header {
    padding: 12px 18px;
    background: #2563eb;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h2 {
    margin: 0;
    font-size: 21px;
}

#otherStatus {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    opacity: 0.95;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

#connectionStatus {
    font-size: 13px;
}


/* =========================
   CALL BUTTONS
   ========================= */

.call-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
}

.call-button {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: white;
    color: #2563eb;
    font-size: 18px;
    cursor: pointer;
}

.call-button:hover {
    background: #dbeafe;
}

.call-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}


/* =========================
   MESSAGES
   ========================= */

#messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: #f8fafc;
}

.message {
    max-width: 75%;
    padding: 10px 14px;
    margin-bottom: 12px;
    border-radius: 14px;
    word-wrap: break-word;
}

.message.me {
    margin-left: auto;
    margin-right: 0;
    background: #dbeafe;
    text-align: left;
}

.message.other {
    margin-left: 0;
    margin-right: auto;
    background: #e2e8f0;
    text-align: left;
}

.message strong {
    display: block;
    margin-bottom: 5px;
    font-size: 13px;
}

.message small {
    display: block;
    margin-top: 5px;
    color: #64748b;
    font-size: 10px;
}


/* =========================
   MESSAGE INPUT
   ========================= */

footer {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #ddd;
    background: white;
}

footer input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #ccc;
    border-radius: 20px;
    outline: none;
    font-size: 15px;
}

footer button {
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: #2563eb;
    color: white;
    font-size: 20px;
    cursor: pointer;
}


/* =========================
   INCOMING CALL POPUP
   ========================= */

.call-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.call-popup-box {
    width: 90%;
    max-width: 360px;
    background: white;
    border-radius: 20px;
    padding: 30px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.call-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.call-popup-box h2 {
    margin: 0 0 8px;
}

.call-popup-box p {
    color: #64748b;
    margin-bottom: 25px;
}

.incoming-call-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.incoming-call-buttons button {
    border: none;
    padding: 12px 18px;
    border-radius: 10px;
    color: white;
    font-size: 15px;
    cursor: pointer;
}

.accept-call {
    background: #16a34a;
}

.accept-call:hover {
    background: #15803d;
}

.reject-call {
    background: #dc2626;
}

.reject-call:hover {
    background: #b91c1c;
}


/* =========================
   ACTIVE CALL
   ========================= */

.active-call-screen {
    position: fixed;
    inset: 0;
    background: #0f172a;
    z-index: 2000;
    display: flex;
    flex-direction: column;
}

.active-call-header {
    padding: 18px;
    color: white;
    display: flex;
    justify-content: space-between;
    background: #111827;
}

#activeCallUser {
    font-size: 18px;
    font-weight: bold;
}

#activeCallStatus {
    font-size: 14px;
    color: #94a3b8;
}


/* =========================
   VIDEO
   ========================= */

.video-area {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

#remoteVideo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
}

#localVideo {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 180px;
    height: 130px;
    object-fit: cover;
    background: #000;
    border-radius: 12px;
    border: 2px solid white;
}


/* =========================
   CALL CONTROLS
   ========================= */

.call-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: #111827;
}

.call-controls button {
    border: none;
    border-radius: 25px;
    padding: 12px 18px;
    background: white;
    color: #111827;
    font-size: 14px;
    cursor: pointer;
}

.call-controls button:hover {
    background: #e2e8f0;
}

.call-controls .end-call {
    background: #dc2626;
    color: white;
}

.call-controls .end-call:hover {
    background: #b91c1c;
}


/* =========================
   STATUS
   ========================= */

.online {
    color: #22c55e;
}

.offline {
    color: #cbd5e1;
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 600px) {

    header {
        padding: 10px 12px;
    }

    header h2 {
        font-size: 18px;
    }

    .header-right {
        gap: 6px;
    }

    #connectionStatus {
        display: none;
    }

    .call-button {
        width: 38px;
        height: 38px;
        font-size: 16px;
    }

    #messages {
        padding: 12px;
    }

    .message {
        max-width: 85%;
    }

    #localVideo {
        width: 120px;
        height: 90px;
        right: 10px;
        bottom: 10px;
    }

    .call-controls {
        padding: 12px 8px;
        gap: 6px;
    }

    .call-controls button {
        padding: 10px 12px;
        font-size: 12px;
    }

}

/* =========================
   STABLE CHAT LAYOUT
   ========================= */

html,
body {
    height: 100%;
    margin: 0;
    overflow: hidden;
}

#chatScreen {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.chat-header {
    flex: 0 0 auto;
    position: relative;
    z-index: 20;
}

#messages {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
}

.chat-input-area {
    flex: 0 0 auto;
    position: relative;
    z-index: 20;
}

/* Keep call popups above everything */
.call-popup,
.active-call-screen {
    z-index: 100;
}

/* Better mobile scrolling */
#messages {
    -webkit-overflow-scrolling: touch;
}

/* Prevent images from breaking the chat width */
#messages img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
}

