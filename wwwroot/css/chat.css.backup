* {
  box-sizing: border-box;
  }

body {
margin: 0;
font-family: Arial, sans-serif;
background: #f1f5f9;
}

/* =========================
LOGIN SCREEN
========================= */

#loginScreen {
height: 100vh;
display: flex;
align-items: center;
justify-content: center;
}

.login-box {
width: 90%;
max-width: 380px;
background: white;
padding: 30px;
border-radius: 16px;
box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
text-align: center;
}

.login-box h1 {
margin-bottom: 25px;
}

.login-box input {
width: 100%;
padding: 14px;
border: 1px solid #ccc;
border-radius: 8px;
font-size: 16px;
margin-bottom: 12px;
}

.login-box button {
width: 100%;
padding: 14px;
border: none;
border-radius: 8px;
background: #2563eb;
color: white;
font-size: 16px;
cursor: pointer;
}

.login-box button:hover {
background: #1d4ed8;
}

#loginError {
color: #dc2626;
margin-top: 12px;
}

/* =========================
CHAT SCREEN
========================= */

#chatScreen {
height: 100vh;
display: flex;
flex-direction: column;
max-width: 900px;
margin: auto;
background: white;
}

/* =========================
HEADER
========================= */

header {
padding: 15px 20px;
background: #2563eb;
color: white;
display: flex;
justify-content: space-between;
align-items: center;
}

header h2 {
margin: 0;
font-size: 21px;
}

#connectionStatus {
font-size: 13px;
}

#otherStatus {
display: block;
margin-top: 4px;
font-size: 13px;
opacity: 0.95;
}

/* =========================
MESSAGES
========================= */

#messages {
flex: 1;
overflow-y: auto;
padding: 20px;
background: #f8fafc;
}

.message {
max-width: 75%;
padding: 10px 14px;
margin-bottom: 12px;
border-radius: 14px;
word-wrap: break-word;
}

/* Logged-in user's message */
.message.me {
margin-left: auto;
margin-right: 0;
background: #dbeafe;
text-align: left;
}

/* Other user's message */
.message.other {
margin-left: 0;
margin-right: auto;
background: #e2e8f0;
text-align: left;
}

.message strong {
display: block;
margin-bottom: 5px;
font-size: 13px;
}

.message small {
display: block;
margin-top: 5px;
color: #64748b;
font-size: 10px;
}

/* =========================
MESSAGE INPUT
========================= */

footer {
display: flex;
gap: 8px;
padding: 12px;
border-top: 1px solid #ddd;
background: white;
}

footer input {
flex: 1;
padding: 12px 16px;
border: 1px solid #ccc;
border-radius: 20px;
outline: none;
font-size: 15px;
}

footer input:focus {
border-color: #2563eb;
}

footer button {
width: 48px;
height: 48px;
border: none;
border-radius: 50%;
background: #2563eb;
color: white;
font-size: 20px;
cursor: pointer;
}

footer button:hover {
background: #1d4ed8;
}

/* =========================
CALLING BUTTONS
========================= */

.call-buttons {
display: flex;
gap: 8px;
align-items: center;
}

.call-button {
width: 42px;
height: 42px;
border: none;
border-radius: 50%;
background: white;
color: #2563eb;
font-size: 18px;
cursor: pointer;
}

.call-button:hover {
background: #eff6ff;
}

.call-button:disabled {
opacity: 0.4;
cursor: not-allowed;
}

/* =========================
ONLINE / OFFLINE
========================= */

.online {
color: #22c55e;
}

.offline {
color: #64748b;
}

/* =========================
MOBILE
========================= */

@media (max-width: 600px) {

```
header {
    padding: 12px 15px;
}

header h2 {
    font-size: 18px;
}

#connectionStatus {
    font-size: 11px;
}

#otherStatus {
    font-size: 12px;
}

.message {
    max-width: 85%;
}

footer {
    padding: 8px;
}

footer input {
    font-size: 14px;
}

footer button {
    width: 44px;
    height: 44px;
}

.call-button {
    width: 38px;
    height: 38px;
}
```

}
